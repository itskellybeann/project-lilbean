# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=lilbean
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=lilbean

# --- Server ---
DATABASE_URL=postgresql://lilbean:change-me-strong-password@db:5432/lilbean
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# Origins allowed to call the API with credentials (comma separated).
CORS_ORIGINS=http://192.168.50.77:8080,http://100.76.202.22:8080

# --- Seed users (first boot only; change passwords after logging in isn't supported yet,
# so pick real passwords here before first `docker compose up`) ---
USER1_EMAIL=kellyeads37@gmail.com
USER1_NAME=Kelly
USER1_PASSWORD=change-me-1
USER2_EMAIL=partner@example.com
USER2_NAME=Partner
USER2_PASSWORD=change-me-2

# --- Push notifications (optional) ---
# Generate a keypair once with: npx web-push generate-vapid-keys
# Leave both blank to disable push entirely (the app works fine without it).
# NOTE: browsers only allow the Push API over HTTPS (localhost is exempt) —
# plain-HTTP LAN/Tailscale access, as set up in this README, will NOT be able
# to subscribe to push until you put an HTTPS reverse proxy in front (e.g.
# `tailscale serve`). The rest of the app is unaffected either way.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Cron schedule (5-field, server's local time) for the "log something today"
# reminder push. Default: 8pm daily.
REMINDER_CRON=0 20 * * *

# --- AI food photo analysis (optional) ---
# Get a key at console.anthropic.com (separate account/billing from a Claude.ai
# subscription — a Pro/Max plan does NOT cover this). Cost is trivial for
# personal use: roughly $0.003 per photo analyzed with the default model.
# Leave blank to disable — the "analyze photo" button just won't appear.
ANTHROPIC_API_KEY=

# --- Web ---
# Base URL the browser uses to reach the API. Leave as /api if served behind the same
# reverse proxy/host as the web app (recommended - see docker-compose.yml).
VITE_API_BASE=/api

# Host port the web container is published on. Only needed if 8080 is already taken
# by something else on your NAS (some NAS OSes reserve it internally) - leave blank
# to use the default 8080.
WEB_PORT=
