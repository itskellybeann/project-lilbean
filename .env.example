# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=lilbean
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=lilbean

# --- Server ---
DATABASE_URL=postgresql://lilbean:change-me-strong-password@db:5432/lilbean
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
# Origins allowed to call the API with credentials (comma separated).
CORS_ORIGINS=http://192.168.50.77:8080,http://100.76.202.22:8080

# --- Seed users (first boot only; change passwords after logging in isn't supported yet,
# so pick real passwords here before first `docker compose up`) ---
USER1_EMAIL=kellyeads37@gmail.com
USER1_NAME=Kelly
USER1_PASSWORD=change-me-1
USER2_EMAIL=partner@example.com
USER2_NAME=Partner
USER2_PASSWORD=change-me-2

# --- Web ---
# Base URL the browser uses to reach the API. Leave as /api if served behind the same
# reverse proxy/host as the web app (recommended - see docker-compose.yml).
VITE_API_BASE=/api
